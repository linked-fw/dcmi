{
  "name": "@_linked/dcmi",
  "license": "MIT",
  "files": [
    "lib",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "version": "1.6.2",
  "packageManager": "npm@12.2.0",
  "linkedPackage": true,
  "linkedOntologies": {
    "dc": {
      "namespace": "http://purl.org/dc/elements/1.1/",
      "data": [
        "dcelems.ttl",
        "dc-added.ttl"
      ]
    },
    "dcterms": {
      "namespace": "http://purl.org/dc/terms/",
      "data": [
        "dcterms.ttl",
        "dcterms-added.ttl"
      ]
    },
    "dcmitype": {
      "namespace": "http://purl.org/dc/dcmitype/",
      "data": [
        "dcmitype.ttl",
        "dcmitype-added.ttl"
      ]
    }
  },
  "type": "module",
  "author": {
    "name": "Valentine Wilson",
    "url": "https://github.com/DiggidyDev",
    "email": "valentinewilson@gmail.com"
  },
  "main": "lib/esm/index.js",
  "description": "This module is an up-to-date specification of all metadata terms maintained by the Dublin Core Metadata Initiative, including properties, vocabulary encoding schemes, syntax encoding schemes, and classes.",
  "scripts": {
    "start": "npm exec linked dev",
    "build": "linked build",
    "test": "node --test test/*.test.mjs"
  },
  "types": "index.d.ts",
  "dependencies": {
    "@_linked/core": "^2.41.0",
    "@_linked/xsd": "^1.4.1"
  },
  "devDependencies": {
    "@_linked/cli": "^1.57.0",
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.0",
    "@types/node": "^24.19.1",
    "tsconfig-to-dual-package": "^1.2.0",
    "typescript": "^5.7.3",
    "typescript-plugin-css-modules": "^5.1.0"
  },
  "module": "lib/esm/index.js",
  "exports": {
    ".": {
      "types": "./lib/esm/index.d.ts",
      "import": "./lib/esm/index.js"
    },
    "./*.js": {
      "types": "./lib/esm/*.d.ts",
      "import": "./lib/esm/*.js"
    },
    "./*": {
      "types": "./lib/esm/*.d.ts",
      "import": "./lib/esm/*.js"
    }
  },
  "typesVersions": {
    "*": {
      "*": [
        "lib/esm/*"
      ]
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/linked-fw/dcmi.git"
  }
}
